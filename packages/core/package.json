{
  "name": "@ts-review-graph/core",
  "version": "0.3.0",
  "description": "Core library for TypeScript dependency graph analysis (SQLite + ts-morph)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["typescript", "dependency-graph", "sqlite", "ts-morph", "blast-radius"],
  "author": "Naoto Nishikawa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elchika-inc/ts-review-graph"
  },
  "homepage": "https://github.com/elchika-inc/ts-review-graph#readme",
  "bugs": { "url": "https://github.com/elchika-inc/ts-review-graph/issues" },
  "engines": { "node": ">=20" },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ts-morph": "^23.0.0",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
